  border-radius: 24px;
  overflow: hidden;
  min-height: 320px;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 34px;
  background: #0d0d12;
  border: 1px solid rgba(255, 255, 255, 0.09);
  box-shadow: 0 24px 50px rgba(0, 0, 0, 0.75);
}

.hero-backdrop {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center 25%;
}

.hero-gradient-overlay {
  position: absolute;
  inset: 0;
  background: 
    linear-gradient(to top, rgba(6, 6, 8, 0.96) 20%, rgba(6, 6, 8, 0.55) 65%, transparent 100%),
    radial-gradient(circle at 100% 0%, rgba(229, 9, 20, 0.22), transparent 50%);
}

.hero-details {
  position: relative;
  z-index: 2;
  max-width: 580px;
}

.hero-eyebrow {
  display: inline-block;
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.14em;
  color: var(--accent-primary);
  margin-bottom: 10px;
}

.hero-title {
  font-family: var(--font-display);
  font-size: clamp(2rem, 4.5vw, 2.7rem);
  font-weight: 800;
  letter-spacing: -0.02em;
  color: #ffffff;
  line-height: 1.15;
  margin-bottom: 10px;
}

.hero-desc {
  font-size: 0.96rem;
  color: var(--text-secondary);
  line-height: 1.55;
  margin-bottom: 22px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.hero-btn-row {
  display: flex;
  gap: 14px;
}

/* ── Live Movie Poster Rails ── */
.poster-scroll-rail {
  display: flex;
  gap: 16px;
  overflow-x: auto;
  padding-bottom: 14px;
  -webkit-overflow-scrolling: touch;
}
.poster-scroll-rail::-webkit-scrollbar { display: none; }

.rail-poster-card {
  position: relative;
  flex: 0 0 148px;
  aspect-ratio: 2/3;
  border-radius: 16px;
  overflow: hidden;
  cursor: pointer;
  background: #14141c;
  border: 1px solid rgba(255, 255, 255, 0.09);
  transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.28s ease;
}
.rail-poster-card:hover {
  transform: translateY(-6px) scale(1.03);
  border-color: rgba(255, 255, 255, 0.3);
}

.rail-poster-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.poster-meta {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(6, 6, 8, 0.95) 0%, rgba(6, 6, 8, 0.25) 50%, transparent 100%);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 12px;
}

.live-indicator, .add-badge, .score-badge {
  align-self: flex-start;
  font-size: 0.68rem;
  font-weight: 800;
  padding: 3px 8px;
  border-radius: 6px;
  letter-spacing: 0.05em;
}
.live-indicator { background: rgba(229, 9, 20, 0.92); color: #fff; }
.add-badge { background: rgba(255, 255, 255, 0.2); backdrop-filter: blur(8px); color: #fff; }
.score-badge { background: rgba(16, 185, 129, 0.9); color: #fff; }

.poster-meta h5 {
  font-family: var(--font-display);
  font-size: 0.88rem;
  font-weight: 700;
  color: #ffffff;
  margin: 0;
  line-height: 1.25;
}

.empty-rail-placeholder {
  background: rgba(255, 255, 255, 0.02);
  border: 1px dashed rgba(255, 255, 255, 0.08);
  border-radius: 16px;
  padding: 28px;
  text-align: center;
  cursor: pointer;
}
.empty-rail-placeholder p {
  font-size: 0.95rem;
  color: var(--text-secondary);
  margin: 0;
}

/* ── Community Hub ── */
.action-cards-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

.action-tile {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 20px;
  padding: 24px;
  cursor: pointer;
  transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
}
.action-tile:hover {
  background: rgba(255, 255, 255, 0.055);
  border-color: rgba(255, 255, 255, 0.18);
  transform: translateY(-3px);
}

.tile-category {
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  color: var(--text-muted);
  display: block;
  margin-bottom: 8px;
}

.action-tile h4 {
  font-family: var(--font-display);
  font-size: 1.25rem;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 6px;
}

.action-tile p {
  font-size: 0.92rem;
  color: var(--text-secondary);
  line-height: 1.5;
  margin: 0;
}

/* ── Reusable Minimal Back Button ── */
.nav-back-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.12);
  color: #ffffff;
  padding: 6px 14px;
  border-radius: 999px;
  font-size: 0.82rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
  flex-shrink: 0;
}
.nav-back-btn:hover {
  background: rgba(255, 255, 255, 0.12);
  border-color: rgba(255, 255, 255, 0.25);
  transform: translateX(-2px);
}

.selector-header-row {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-bottom: 8px;
}

@media (max-width: 580px) {
  .cinema-hero {
    min-height: 260px;
    padding: 22px;
  }
  .action-cards-grid {
    grid-template-columns: 1fr;
  }
  .home-dashboard {
    padding-bottom: 170px !important;
  }
}
</file>

